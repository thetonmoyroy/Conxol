{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conxol",
  "version": "0.1.65",
  "identifier": "com.othmane.conxol",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://127.0.0.1:15420",
    "beforeBuildCommand": "node ../../tools/prepare-desktop.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Conxol - Your network, in command",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 680,
        "decorations": true,
        "backgroundColor": "#0b100f",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; base-uri 'none'; object-src 'none'; frame-ancestors 'none'; connect-src ipc: http://ipc.localhost http://127.0.0.1:15420; img-src 'self' asset: https://asset.localhost data:; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "resources": {
      "../src/assets/fonts/JetBrainsMono-OFL.txt": "licenses/JetBrainsMono-OFL.txt",
      "../../../LICENSE": "LICENSE",
      "../../../NOTICE": "NOTICE"
    },
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "installerHooks": "installer-metadata.nsh"
      }
    },
    "publisher": "Tonmoy",
    "homepage": "https://github.com/thetonmoyroy/Conxol",
    "copyright": "Copyright 2026 Othmane Blial",
    "license": "Apache-2.0",
    "licenseFile": "../../../LICENSE",
    "category": "DeveloperTool",
    "shortDescription": "Conxol terminal and remote connection manager",
    "longDescription": "Conxol provides local terminals, saved SSH sessions, SFTP file transfers, serial connections, and network administration tools."
  }
}
